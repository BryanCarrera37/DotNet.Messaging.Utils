<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>DotNet.Messaging.Utils</PackageId>
		<Version>1.0.0</Version>
		<Authors>BryanCM</Authors>
		<PackageTags>rabbitmq;messaging;auth;oauth;keycloak;entraid;utils;helpers;publisher;consumer</PackageTags>
		<Description>.NET Package that allow developers several functionalities to work with RabbitMQ in their projects and introduces some pre-designed classes and methods for common scenarios and techniques (Dead-Letter, Parking Lot, etc).</Description>
		<PackageProjectUrl>https://github.com/BryanCarrera37/DotNet.Messaging.Utils.git</PackageProjectUrl>
		<RepositoryUrl>https://github.com/BryanCarrera37/DotNet.Messaging.Utils.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BryanCM.AspNet.Utils" Version="1.0.4" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
		<PackageReference Include="Microsoft.Identity.Client" Version="4.84.2" />
		<PackageReference Include="RabbitMQ.Client" Version="7.1.2" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\.gitignore" />
	</ItemGroup>
</Project>
